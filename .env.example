# Root env vars consumed by docker-compose.yml.
# On Windows/Mac Docker Desktop, host.docker.internal already resolves to the host
# machine, so the local Hardhat node (npx hardhat node) is reachable from containers.
RPC_URL=http://host.docker.internal:8545
CHAIN_ID=31337
VAULT_ADDRESS=
STRATEGY_MANAGER_ADDRESS=
CONFIRMATIONS=3
POLL_INTERVAL_MS=2000

# GĐ5 - Multichain: chỉ cần khi chạy `docker compose --profile multichain up` để index
# thêm chain thứ 2 (ví dụ Base Sepolia) song song với chain chính ở trên - service
# indexer-chain-b, KHÔNG bắt buộc cho single-chain (mặc định `docker compose up`).
RPC_URL_CHAIN_B=
CHAIN_ID_CHAIN_B=
VAULT_ADDRESS_CHAIN_B=
STRATEGY_MANAGER_ADDRESS_CHAIN_B=
CONFIRMATIONS_CHAIN_B=3

# Vault Security Audit: docker-compose.yml không còn hardcode credential mặc định -
# copy file này thành .env rồi đổi các giá trị dưới đây trước khi lên staging/production
# (giá trị mẫu ở đây CHỈ an toàn cho local dev, không phải giá trị thật).
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redis
GRAFANA_ADMIN_PASSWORD=admin
# Phải khớp với INTERNAL_API_KEY trong backend/.env - dùng để gọi POST /policy/evaluate.
INTERNAL_API_KEY=local-dev-only-change-me
