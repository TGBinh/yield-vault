PORT=3001
POSTGRES_URL=
REDIS_URL=

# Vault Security Audit - Critical C3: shared secret nội bộ bắt buộc để gọi
# POST /policy/evaluate (route duy nhất thực sự claim slot cooldown rebalance).
# Không set biến này -> route bị khoá hoàn toàn (fail-closed), không mở public.
INTERNAL_API_KEY=

# Phase 4 (GD4): risk-engine and ai-engine service URLs, used by
# GET /recommendations/latest to orchestrate Risk Engine -> AI Engine -> Policy Engine.
RISK_ENGINE_URL=http://localhost:8002
AI_ENGINE_URL=http://localhost:8001
