ARBITRUM_SEPOLIA_RPC_URL=
# GĐ5 - Multichain: chain thứ 2 (Base Sepolia), dùng chung DEPLOYER_PRIVATE_KEY bên dưới.
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Các biến deploy.ts dưới đây đều tuỳ chọn - không set thì dùng đường mặc định an toàn
# cho local/dev (xem comment tương ứng trong scripts/deploy.ts).
# Set cả 2 để deploy AaveStrategy thay vì MockStrategy (testnet thật có Aave Pool).
AAVE_POOL_ADDRESS=
AAVE_ATOKEN_ADDRESS=
# Địa chỉ Safe multisig thật làm proposer của RebalanceTimelock - không set thì mặc định
# dùng chính deployer (CHỈ chấp nhận được cho local/dev, không phải production).
GOVERNANCE_MULTISIG_ADDRESS=
# Danh sách địa chỉ EOA riêng lẻ được cấp GUARDIAN_ROLE, phân cách bởi dấu phẩy.
GUARDIAN_ADDRESSES=
# TVL cap (đơn vị nhỏ nhất của asset, USDC 6 decimals) - không set thì Vault uncapped.
DEPOSIT_CAP_RAW=
