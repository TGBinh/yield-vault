# RPC endpoint of the chain to index (local Hardhat node by default)
RPC_URL=http://127.0.0.1:8545

# Chain ID of the chain above (31337 = local Hardhat node)
CHAIN_ID=31337

# Postgres connection string
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/yield_vault

# Deployed contract addresses (read from frontend/src/lib/deployments.local.json
# after running the deploy script, or set to your target network's addresses)
VAULT_ADDRESS=
STRATEGY_MANAGER_ADDRESS=

# Number of blocks to wait before marking an indexed event as confirmed
CONFIRMATIONS=3

# Poll interval (ms) used by the log-polling watcher loop
POLL_INTERVAL_MS=2000

# Port for the /metrics (Prometheus) and /health HTTP endpoints
METRICS_PORT=9464
