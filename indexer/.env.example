# RPC endpoint of the chain to index (local Hardhat node by default)
RPC_URL=http://127.0.0.1:8545

# Chain ID of the chain above (31337 = local Hardhat node)
CHAIN_ID=31337

# Postgres connection string
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/yield_vault

# Deployed contract addresses (read from frontend/src/lib/deployments.local.json
# after running the deploy script, or set to your target network's addresses)
VAULT_ADDRESS=
STRATEGY_MANAGER_ADDRESS=

# Phase 3 (Governance page) - optional, indexer bỏ qua watch RebalanceTimelock/
# CrossChainTimelock nếu để trống.
REBALANCE_TIMELOCK_ADDRESS=
CROSS_CHAIN_TIMELOCK_ADDRESS=

# Number of blocks to wait before marking an indexed event as confirmed
CONFIRMATIONS=3

# Poll interval (ms) used by the log-polling watcher loop
POLL_INTERVAL_MS=2000

# Port for the /metrics (Prometheus) and /health HTTP endpoints
METRICS_PORT=9464

# Phase 1 (dashboard performance chart) - minimum gap (ms) between vault_snapshots rows.
SNAPSHOT_INTERVAL_MS=300000

# Phase 4 (realtime notifications) - optional, không set thì indexer bỏ qua publish Redis
# hoàn toàn (xem src/redis-publisher.ts). Nếu chạy indexer trực tiếp (npm run dev, không
# qua Docker Compose) và Redis chạy qua docker-compose.yml, nhớ kèm password
# (redis://:<REDIS_PASSWORD>@localhost:6380).
REDIS_URL=redis://localhost:6380
